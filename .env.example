# Copie para .env.local e preencha. NUNCA versione o .env.local.
DATABASE_URL=postgresql://mouora:mouora_dev_pw@127.0.0.1:5433/mouora
AUTH_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres

# Envio de e-mail (Gmail com SENHA DE APP: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-letras
SMTP_FROM="MOUORA AI <seu-email@gmail.com>"

# true = exige código por e-mail no cadastro
REQUIRE_EMAIL_VERIFICATION=true
# true = imprime os e-mails no console em vez de enviar (somente desenvolvimento)
MAIL_DEV_LOG=false
